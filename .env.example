# Copy to .env for local development (`cp .env.example .env`). .env is gitignored.
# Real environment variables take precedence over values in .env.

# Optional Jira Cloud integration — set all three to enable the "Add worklog" button.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
